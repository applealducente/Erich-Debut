{
  "rules": {
    ".read": false,
    "rsvps": {
      ".read": true,
      "$guest": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['guestName', 'attendance', 'submittedAt'])",
        "guestName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "attendance": { ".validate": "newData.val() === 'yes' || newData.val() === 'no'" },
        "message": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "table": { ".validate": "newData.isNumber()" },
        "submittedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    }
  }
}
